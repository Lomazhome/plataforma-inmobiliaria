{
  "trailingSlash": false,
  "functions": {
    "api/agente-marketing.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/blog",
      "destination": "/blog.html",
      "permanent": false
    },
    {
      "source": "/blog/:carpeta/:resto+",
      "destination": "/blog.html",
      "permanent": false
    },
    {
      "source": "/blog/:archivo(.*\\.[a-zA-Z0-9]{2,5})",
      "destination": "/blog.html",
      "permanent": false
    },
    {
      "source": "/articulo.html",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "(?<slugviejo>[A-Za-z0-9-]+)"
        }
      ],
      "destination": "/blog/:slugviejo",
      "permanent": true
    },
    {
      "source": "/articulo.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<idviejo>[0-9a-fA-F-]{36})"
        }
      ],
      "destination": "/api/blog-articulo?id=:idviejo",
      "permanent": false
    },
    {
      "source": "/articulo.html",
      "destination": "/blog.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/api/blog-articulo?slug=:slug"
    },
    {
      "source": "/sitemap-blog.xml",
      "destination": "/api/sitemap-blog"
    },
    {
      "source": "/semaforo-del-inversionista",
      "destination": "/semaforo-del-inversionista.html"
    },
    {
      "source": "/equipo",
      "destination": "/asesores.html"
    },
    {
      "source": "/asesor/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|vkShare|SkypeUriPreview|Applebot|Iframely|Embedly).*"
        }
      ],
      "destination": "/api/tarjeta-og?slug=:slug"
    },
    {
      "source": "/asesor/:slug",
      "destination": "/asesor.html"
    },
    {
      "source": "/tarjeta/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|vkShare|SkypeUriPreview|Applebot|Iframely|Embedly).*"
        }
      ],
      "destination": "/api/tarjeta-og?slug=:slug"
    },
    {
      "source": "/tarjeta/:slug",
      "destination": "/asesor.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://cdnjs.cloudflare.com https://*.supabase.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: blob: https://images.unsplash.com https://*.supabase.co https://*.googleusercontent.com https://*.tile.openstreetmap.org https://unpkg.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://nominatim.openstreetmap.org; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
